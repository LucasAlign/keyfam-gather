{
  "name": "keyfam-gather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "replit:dev": "node scripts/replit-run.mjs dev",
    "replit:start": "node scripts/replit-run.mjs start",
    "replit:seed": "node scripts/replit-run.mjs seed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "user:manage": "tsx scripts/manage-user.ts",
    "verify:postgres": "tsx scripts/verify-postgres-server.ts",
    "verify:load": "tsx scripts/load-test.ts",
    "verify:postgres:contract": "tsx scripts/verify-postgres.ts",
    "verify:docker": "bash scripts/verify-docker.sh",
    "verify:event-configuration": "tsx scripts/verify-event-configuration.ts",
    "verify:events-schema": "bash scripts/verify-events-module.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
