generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ORGANIZATION_ADMIN
  EVENT_ADMIN
  EVENT_STAFF
  VIEWER
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EVENT_LIVE
  COMPLETED
  ARCHIVED
}

enum RegistrationSource {
  PUBLIC
  HOST
  STAFF
  INVITATION
  WALK_IN
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  people        Person[]
  events        Event[]
  groups        Group[]
  seatingTables SeatingTable[]
  parties       Party[]
  eventHosts    EventHost[]
  registrations Registration[]
  checkIns      CheckIn[]
  auditLogs     AuditLog[]
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String
  createdAt        DateTime     @default(now())
  memberships      Membership[]
  auditLogs        AuditLog[]   @relation("AuditActor")
  checkIns         CheckIn[]    @relation("CheckInActor")
  reversedCheckIns CheckIn[]    @relation("CheckInReversedBy")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Person {
  id              String         @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations   Registration[]
  eventHosts      EventHost[]

  @@unique([organizationId, emailNormalized])
  @@unique([organizationId, phoneNormalized])
  @@index([organizationId, lastName, firstName])
}

model Event {
  id                   String         @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  status               EventStatus    @default(DRAFT)
  startsAt             DateTime
  endsAt               DateTime
  timezone             String
  venue                String?
  address              String?
  capacity             Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  isPublic             Boolean        @default(false)
  contactEmail         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations        Registration[]
  groups               Group[]
  seatingTables        SeatingTable[]
  parties              Party[]
  eventHosts           EventHost[]
  checkIns             CheckIn[]

  @@index([organizationId, startsAt])
}

model Registration {
  id             String             @id @default(cuid())
  organizationId String
  eventId        String
  personId       String
  groupId        String?
  tableId        String?
  partyId        String?
  source         RegistrationSource @default(STAFF)
  registeredAt   DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person         Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  group          Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  table          SeatingTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  party          Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  checkIn        CheckIn?

  @@unique([eventId, personId])
  @@index([organizationId, eventId])
  @@index([groupId])
  @@index([tableId])
  @@index([partyId])
}

model CheckIn {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  registrationId String       @unique
  actorId        String
  deviceId       String
  checkedInAt    DateTime     @default(now())
  reversedAt     DateTime?
  reversedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User         @relation("CheckInActor", fields: [actorId], references: [id], onDelete: Restrict)
  reversedBy     User?        @relation("CheckInReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, reversedAt])
  @@index([eventId, checkedInAt])
}

model SeatingTable {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  capacity       Int
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model Party {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model Group {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  capacity       Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hosts          EventHost[]
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model EventHost {
  id             String            @id @default(cuid())
  organizationId String
  eventId        String
  personId       String
  groupId        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person         Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  group          Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessTokens   HostAccessToken[]
  auditLogs      AuditLog[]        @relation("AuditHost")

  @@unique([eventId, personId])
  @@index([organizationId, eventId])
  @@index([groupId])
}

model HostAccessToken {
  id          String    @id @default(cuid())
  eventHostId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  eventHost   EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  @@index([eventHostId, expiresAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String?
  actorId        String?
  eventHostId    String?
  action         String
  entityType     String
  entityId       String
  previousState  String?
  newState       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  eventHost      EventHost?   @relation("AuditHost", fields: [eventHostId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, createdAt])
}
