generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ORGANIZATION_ADMIN
  EVENT_ADMIN
  EVENT_STAFF
  VIEWER
  MEMBER
}

enum EventRole {
  EVENT_ADMIN
  EVENT_STAFF
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EVENT_LIVE
  COMPLETED
  ARCHIVED
}

enum RegistrationSource {
  PUBLIC
  HOST
  STAFF
  INVITATION
  WALK_IN
}

enum InvitationStatus {
  DRAFT
  SENT
  OPENED
  REGISTERED
  DECLINED
  CANCELLED
  NO_RESPONSE
}

enum AttendanceOperationKind {
  CHECK_IN
  UNDO
}

enum AttendanceDisposition {
  APPLIED
  ALREADY_APPLIED
  CONFLICT
  REJECTED
}

enum AttendanceResultCode {
  ALREADY_CHECKED_IN
  ALREADY_REVERSED
  UNDO_EXPIRED
  STALE_VERSION
  NOT_FOUND
  FORBIDDEN
  OPERATION_ID_REUSED
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          Membership[]
  eventAssignments     EventAssignment[]
  people               Person[]
  events               Event[]
  groups               Group[]
  seatingTables        SeatingTable[]
  parties              Party[]
  eventHosts           EventHost[]
  registrations        Registration[]
  checkIns             CheckIn[]
  attendanceOperations AttendanceOperation[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  createdAt            DateTime              @default(now())
  memberships          Membership[]
  eventAssignments     EventAssignment[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  checkIns             CheckIn[]             @relation("CheckInActor")
  reversedCheckIns     CheckIn[]             @relation("CheckInReversedBy")
  attendanceOperations AttendanceOperation[]
  sentInvitations      Invitation[]          @relation("InvitationSender")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model EventAssignment {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  eventId        String
  role           EventRole
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([organizationId, eventId])
}

model Person {
  id              String         @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations   Registration[]
  eventHosts      EventHost[]
  invitations     Invitation[]

  @@unique([organizationId, emailNormalized])
  @@unique([organizationId, phoneNormalized])
  @@index([organizationId, lastName, firstName])
}

model Event {
  id                   String                @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  status               EventStatus           @default(DRAFT)
  startsAt             DateTime
  endsAt               DateTime
  timezone             String
  venue                String?
  address              String?
  capacity             Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  isPublic             Boolean               @default(false)
  contactEmail         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations        Registration[]
  groups               Group[]
  seatingTables        SeatingTable[]
  parties              Party[]
  eventHosts           EventHost[]
  checkIns             CheckIn[]
  attendanceOperations AttendanceOperation[]
  assignments          EventAssignment[]
  invitations          Invitation[]

  @@index([organizationId, startsAt])
}

model Registration {
  id                   String                @id @default(cuid())
  organizationId       String
  eventId              String
  personId             String
  groupId              String?
  tableId              String?
  partyId              String?
  source               RegistrationSource    @default(STAFF)
  registeredAt         DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person               Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  group                Group?                @relation(fields: [groupId], references: [id], onDelete: SetNull)
  table                SeatingTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  party                Party?                @relation(fields: [partyId], references: [id], onDelete: SetNull)
  checkIn              CheckIn?
  attendanceOperations AttendanceOperation[]
  invitation           Invitation?

  @@unique([eventId, personId])
  @@index([organizationId, eventId])
  @@index([groupId])
  @@index([tableId])
  @@index([partyId])
}

model CheckIn {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  registrationId String       @unique
  actorId        String
  deviceId       String
  checkedInAt    DateTime     @default(now())
  reversedAt     DateTime?
  reversedById   String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User         @relation("CheckInActor", fields: [actorId], references: [id], onDelete: Restrict)
  reversedBy     User?        @relation("CheckInReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, reversedAt])
  @@index([eventId, checkedInAt])
}

model AttendanceOperation {
  id              String                  @id @default(cuid())
  operationId     String                  @unique
  organizationId  String
  eventId         String
  registrationId  String
  actorId         String
  deviceId        String
  kind            AttendanceOperationKind
  occurredAt      DateTime
  expectedVersion Int?
  disposition     AttendanceDisposition
  resultCode      AttendanceResultCode?
  commandHash     String
  canonicalResult String
  createdAt       DateTime                @default(now())
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration    Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor           User                    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, createdAt])
  @@index([eventId, deviceId, createdAt])
  @@index([registrationId, createdAt])
}

model SeatingTable {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  capacity       Int
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model Party {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model Group {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  capacity       Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hosts          EventHost[]
  registrations  Registration[]
  invitations    Invitation[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model EventHost {
  id              String            @id @default(cuid())
  organizationId  String
  eventId         String
  personId        String
  groupId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person          Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  group           Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessTokens    HostAccessToken[]
  auditLogs       AuditLog[]        @relation("AuditHost")
  sentInvitations Invitation[]      @relation("InvitationHostSender")

  @@unique([eventId, personId])
  @@index([organizationId, eventId])
  @@index([groupId])
}

model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  eventId         String
  senderId        String?
  eventHostId     String?
  groupId         String?
  inviteeId       String?
  registrationId  String?          @unique
  firstName       String
  lastName        String
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  tokenHash       String           @unique
  status          InvitationStatus @default(DRAFT)
  sentAt          DateTime?
  openedAt        DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender          User?            @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Restrict)
  eventHost       EventHost?       @relation("InvitationHostSender", fields: [eventHostId], references: [id], onDelete: Restrict)
  group           Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invitee         Person?          @relation(fields: [inviteeId], references: [id], onDelete: SetNull)
  registration    Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventId, status])
  @@index([eventId, groupId, createdAt])
  @@index([emailNormalized])
  @@index([phoneNormalized])
}

model HostAccessToken {
  id          String    @id @default(cuid())
  eventHostId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  eventHost   EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  @@index([eventHostId, expiresAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String?
  actorId        String?
  eventHostId    String?
  action         String
  entityType     String
  entityId       String
  previousState  String?
  newState       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  eventHost      EventHost?   @relation("AuditHost", fields: [eventHostId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, createdAt])
}
