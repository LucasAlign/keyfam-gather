generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ORGANIZATION_ADMIN
  EVENT_ADMIN
  EVENT_STAFF
  VIEWER
  MEMBER
}

enum EventRole {
  EVENT_ADMIN
  EVENT_STAFF
  CHECKIN_LEAD
  VOLUNTEER
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EVENT_LIVE
  COMPLETED
  ARCHIVED
}

enum RegistrationSource {
  PUBLIC
  HOST
  STAFF
  INVITATION
  WALK_IN
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
  SUPERSEDED
}

enum RegistrationFieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  DATE
  DROPDOWN
  RADIO
  CHECKBOX
  YES_NO
}

enum RegistrationFieldVisibility {
  PUBLIC
  ADMIN_ONLY
  HIDDEN
}

enum InvitationStatus {
  DRAFT
  SENT
  OPENED
  REGISTERED
  DECLINED
  CANCELLED
  NO_RESPONSE
}

enum AttendanceOperationKind {
  CHECK_IN
  UNDO
}

enum AttendanceDisposition {
  APPLIED
  ALREADY_APPLIED
  CONFLICT
  REJECTED
}

enum AttendanceResultCode {
  ALREADY_CHECKED_IN
  ALREADY_REVERSED
  UNDO_EXPIRED
  STALE_VERSION
  NOT_FOUND
  FORBIDDEN
  OPERATION_ID_REUSED
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum MessageCategory {
  INVITATION
  CONFIRMATION
  REMINDER
  LOGISTICS
  THANK_YOU
  NO_SHOW
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum FundraisingCommitmentKind {
  DONATION
  PLEDGE
  SPONSORSHIP
  TICKET
}

enum FundraisingCommitmentStatus {
  ACTIVE
  CANCELLED
}

enum FinancialTransactionKind {
  PAYMENT
  REFUND
}

enum SponsorshipFulfillmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

model Organization {
  id                     String                    @id @default(cuid())
  name                   String
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  memberships            Membership[]
  eventAssignments       EventAssignment[]
  people                 Person[]
  events                 Event[]
  groups                 Group[]
  seatingTables          SeatingTable[]
  parties                Party[]
  eventHosts             EventHost[]
  registrations          Registration[]
  checkIns               CheckIn[]
  attendanceOperations   AttendanceOperation[]
  invitations            Invitation[]
  auditLogs              AuditLog[]
  registrationFields     EventRegistrationField[]
  registrationAnswers    RegistrationFieldAnswer[]
  personMerges           PersonMerge[]
  checkInTokens          CheckInToken[]
  deliveryAttempts       DeliveryAttempt[]
  fundraisingCommitments FundraisingCommitment[]
  financialTransactions  FinancialTransaction[]
  sponsors               Sponsor[]
  sponsorships           Sponsorship[]
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  passwordHash         String?
  sessionVersion       Int                   @default(1)
  createdAt            DateTime              @default(now())
  memberships          Membership[]
  eventAssignments     EventAssignment[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  checkIns             CheckIn[]             @relation("CheckInActor")
  reversedCheckIns     CheckIn[]             @relation("CheckInReversedBy")
  attendanceOperations AttendanceOperation[]
  sentInvitations      Invitation[]          @relation("InvitationSender")
  personMerges         PersonMerge[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model EventAssignment {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  eventId        String
  role           EventRole
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([organizationId, eventId])
}

model Person {
  id                     String                  @id @default(cuid())
  organizationId         String
  firstName              String
  lastName               String
  email                  String?
  emailNormalized        String?
  phone                  String?
  phoneNormalized        String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  region                 String?
  postalCode             String?
  country                String?
  addressNormalized      String?
  mergedIntoPersonId     String?
  mergedAt               DateTime?
  communicationOptOut    Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations          Registration[]
  campaignDeliveries     CampaignDelivery[]
  eventHosts             EventHost[]
  invitations            Invitation[]
  mergedInto             Person?                 @relation("PersonMergeTombstone", fields: [mergedIntoPersonId], references: [id], onDelete: Restrict)
  mergedPeople           Person[]                @relation("PersonMergeTombstone")
  mergeSources           PersonMerge[]           @relation("PersonMergeSource")
  mergeTargets           PersonMerge[]           @relation("PersonMergeTarget")
  fundraisingCommitments FundraisingCommitment[]
  sponsorContacts        Sponsor[]

  @@unique([organizationId, emailNormalized])
  @@unique([organizationId, phoneNormalized])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, addressNormalized, lastName, firstName])
  @@index([mergedIntoPersonId])
}

model Event {
  id                     String                    @id @default(cuid())
  organizationId         String
  name                   String
  description            String?
  eventType              String                    @default("Fundraising event")
  status                 EventStatus               @default(DRAFT)
  startsAt               DateTime
  endsAt                 DateTime
  timezone               String
  venue                  String?
  address                String?
  capacity               Int?
  registrationOpensAt    DateTime?
  registrationClosesAt   DateTime?
  isPublic               Boolean                   @default(false)
  contactEmail           String?
  contactName            String?
  contactPhone           String?
  brandingPrimaryColor   String                    @default("#173a32")
  brandingLogoUrl        String?
  fundraisingGoalCents   Int?
  currency               String                    @default("USD") @db.Char(3)
  rolledOverFromEventId  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolledOverFrom         Event?                    @relation("EventRollover", fields: [rolledOverFromEventId], references: [id], onDelete: SetNull)
  rollovers              Event[]                   @relation("EventRollover")
  registrations          Registration[]
  groups                 Group[]
  seatingTables          SeatingTable[]
  parties                Party[]
  eventHosts             EventHost[]
  checkIns               CheckIn[]
  attendanceOperations   AttendanceOperation[]
  assignments            EventAssignment[]
  invitations            Invitation[]
  registrationFields     EventRegistrationField[]
  registrationAnswers    RegistrationFieldAnswer[]
  personMerges           PersonMerge[]
  checkInTokens          CheckInToken[]
  deliveryAttempts       DeliveryAttempt[]
  fundraisingCommitments FundraisingCommitment[]
  financialTransactions  FinancialTransaction[]
  sponsors               Sponsor[]
  sponsorships           Sponsorship[]
  messageTemplates       MessageTemplate[]
  campaigns              Campaign[]
  campaignDeliveries     CampaignDelivery[]

  @@index([organizationId, startsAt])
  @@index([rolledOverFromEventId])
}

model FundraisingCommitment {
  id             String                      @id @default(cuid())
  organizationId String
  eventId        String
  personId       String?
  groupId        String?
  kind           FundraisingCommitmentKind
  status         FundraisingCommitmentStatus @default(ACTIVE)
  amountCents    Int
  description    String?
  committedAt    DateTime                    @default(now())
  cancelledAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person         Person?                     @relation(fields: [personId], references: [id], onDelete: SetNull)
  group          Group?                      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transactions   FinancialTransaction[]
  sponsorship    Sponsorship?

  @@index([organizationId, eventId, status])
  @@index([personId])
  @@index([groupId])
}

model Sponsor {
  id                     String        @id @default(cuid())
  organizationId         String
  eventId                String
  name                   String
  primaryContactPersonId String?
  logoUrl                String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  primaryContact         Person?       @relation(fields: [primaryContactPersonId], references: [id], onDelete: SetNull)
  sponsorships           Sponsorship[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
  @@index([primaryContactPersonId])
}

model Sponsorship {
  id                String                       @id @default(cuid())
  organizationId    String
  eventId           String
  sponsorId         String
  commitmentId      String                       @unique
  groupId           String?
  level             String
  guestAllotment    Int                          @default(0)
  benefits          String?
  recognitionNeeds  String?
  fulfillmentStatus SponsorshipFulfillmentStatus @default(NOT_STARTED)
  fulfillmentNotes  String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event             Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor           Sponsor                      @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  commitment        FundraisingCommitment        @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  group             Group?                       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventId, fulfillmentStatus])
  @@index([sponsorId])
  @@index([groupId])
}

model FinancialTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  eventId        String
  commitmentId   String
  kind           FinancialTransactionKind
  amountCents    Int
  occurredAt     DateTime                 @default(now())
  note           String?
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commitment     FundraisingCommitment    @relation(fields: [commitmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, occurredAt])
  @@index([commitmentId, occurredAt])
}

model Registration {
  id                         String                    @id @default(cuid())
  organizationId             String
  eventId                    String
  personId                   String
  groupId                    String?
  tableId                    String?
  partyId                    String?
  source                     RegistrationSource        @default(STAFF)
  status                     RegistrationStatus        @default(ACTIVE)
  registeredAt               DateTime                  @default(now())
  cancelledAt                DateTime?
  supersededAt               DateTime?
  supersededByRegistrationId String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                      Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person                     Person                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  group                      Group?                    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  table                      SeatingTable?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  party                      Party?                    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  checkIn                    CheckIn?
  attendanceOperations       AttendanceOperation[]
  invitation                 Invitation?
  fieldAnswers               RegistrationFieldAnswer[]
  checkInTokens              CheckInToken[]
  supersededBy               Registration?             @relation("RegistrationSupersession", fields: [supersededByRegistrationId], references: [id], onDelete: Restrict)
  supersededRegistrations    Registration[]            @relation("RegistrationSupersession")

  @@unique([eventId, personId])
  @@index([organizationId, eventId])
  @@index([organizationId, eventId, status])
  @@index([groupId])
  @@index([tableId])
  @@index([partyId])
  @@index([supersededByRegistrationId])
}

model EventRegistrationField {
  id             String                         @id @default(cuid())
  organizationId String
  eventId        String
  key            String
  label          String
  helpText       String?
  type           RegistrationFieldType
  visibility     RegistrationFieldVisibility    @default(PUBLIC)
  isRequired     Boolean                        @default(false)
  sortOrder      Int
  isActive       Boolean                        @default(true)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  options        EventRegistrationFieldOption[]
  answers        RegistrationFieldAnswer[]

  @@unique([eventId, key])
  @@index([organizationId, eventId, sortOrder])
}

model EventRegistrationFieldOption {
  id        String                 @id @default(cuid())
  fieldId   String
  value     String
  label     String
  sortOrder Int
  field     EventRegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, value])
  @@index([fieldId, sortOrder])
}

model RegistrationFieldAnswer {
  id             String                 @id @default(cuid())
  organizationId String
  eventId        String
  registrationId String
  fieldId        String
  value          Json
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  field          EventRegistrationField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([registrationId, fieldId])
  @@index([organizationId, eventId])
  @@index([eventId, fieldId])
}

model PersonMerge {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String?
  sourcePersonId String
  targetPersonId String
  actorId        String
  reason         String?
  sourceSnapshot Json
  targetSnapshot Json
  resultSnapshot Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sourcePerson   Person       @relation("PersonMergeSource", fields: [sourcePersonId], references: [id], onDelete: Restrict)
  targetPerson   Person       @relation("PersonMergeTarget", fields: [targetPersonId], references: [id], onDelete: Restrict)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([sourcePersonId])
  @@index([targetPersonId])
}

model CheckIn {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  registrationId String       @unique
  actorId        String
  deviceId       String
  checkedInAt    DateTime     @default(now())
  reversedAt     DateTime?
  reversedById   String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User         @relation("CheckInActor", fields: [actorId], references: [id], onDelete: Restrict)
  reversedBy     User?        @relation("CheckInReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, reversedAt])
  @@index([eventId, checkedInAt])
}

model AttendanceOperation {
  id              String                  @id @default(cuid())
  operationId     String                  @unique
  organizationId  String
  eventId         String
  registrationId  String
  actorId         String
  deviceId        String
  kind            AttendanceOperationKind
  occurredAt      DateTime
  expectedVersion Int?
  disposition     AttendanceDisposition
  resultCode      AttendanceResultCode?
  commandHash     String
  canonicalResult String
  createdAt       DateTime                @default(now())
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration    Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor           User                    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, createdAt])
  @@index([eventId, deviceId, createdAt])
  @@index([registrationId, createdAt])
}

model SeatingTable {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  capacity       Int
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model Party {
  id             String         @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model Group {
  id                     String                  @id @default(cuid())
  organizationId         String
  eventId                String
  name                   String
  capacity               Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                  Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hosts                  EventHost[]
  registrations          Registration[]
  invitations            Invitation[]
  sponsorships           Sponsorship[]
  fundraisingCommitments FundraisingCommitment[]

  @@unique([eventId, name])
  @@index([organizationId, eventId])
}

model EventHost {
  id              String            @id @default(cuid())
  organizationId  String
  eventId         String
  personId        String
  groupId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person          Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  group           Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accessTokens    HostAccessToken[]
  auditLogs       AuditLog[]        @relation("AuditHost")
  sentInvitations Invitation[]      @relation("InvitationHostSender")

  @@unique([eventId, personId])
  @@index([organizationId, eventId])
  @@index([groupId])
}

model Invitation {
  id               String            @id @default(cuid())
  organizationId   String
  eventId          String
  senderId         String?
  eventHostId      String?
  groupId          String?
  inviteeId        String?
  registrationId   String?           @unique
  firstName        String
  lastName         String
  email            String?
  emailNormalized  String?
  phone            String?
  phoneNormalized  String?
  tokenHash        String            @unique
  status           InvitationStatus  @default(DRAFT)
  sentAt           DateTime?
  openedAt         DateTime?
  respondedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender           User?             @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Restrict)
  eventHost        EventHost?        @relation("InvitationHostSender", fields: [eventHostId], references: [id], onDelete: Restrict)
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invitee          Person?           @relation(fields: [inviteeId], references: [id], onDelete: SetNull)
  registration     Registration?     @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  deliveryAttempts DeliveryAttempt[]

  @@index([organizationId, eventId, status])
  @@index([eventId, groupId, createdAt])
  @@index([emailNormalized])
  @@index([phoneNormalized])
}

model HostAccessToken {
  id          String    @id @default(cuid())
  eventHostId String
  tokenHash   String    @unique
  tokenCipher String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  eventHost   EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  @@index([eventHostId, expiresAt])
}

model CheckInToken {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  registrationId String
  tokenHash      String       @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, revokedAt])
  @@index([organizationId, eventId])
}

model DeliveryAttempt {
  id                String          @id @default(cuid())
  organizationId    String
  eventId           String
  invitationId      String
  channel           DeliveryChannel
  provider          String
  recipient         String
  status            DeliveryStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation        Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventId, createdAt])
  @@index([invitationId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String?
  actorId        String?
  eventHostId    String?
  action         String
  entityType     String
  entityId       String
  previousState  String?
  newState       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  eventHost      EventHost?   @relation("AuditHost", fields: [eventHostId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventId, createdAt])
}

model PublicRateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

// Event communications center (issue #17). Reusable templates, campaigns
// targeting computed audience segments, and per-recipient delivery records.
model MessageTemplate {
  id             String          @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  category       MessageCategory
  channel        DeliveryChannel
  subject        String?
  body           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]

  @@index([organizationId, eventId])
}

model Campaign {
  id             String            @id @default(cuid())
  organizationId String
  eventId        String
  name           String
  category       MessageCategory
  channel        DeliveryChannel
  segment        String
  subject        String?
  body           String
  status         CampaignStatus    @default(DRAFT)
  scheduledFor   DateTime?
  templateId     String?
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  sentAt         DateTime?
  totalRecipients Int              @default(0)
  sentCount      Int               @default(0)
  failedCount    Int               @default(0)
  optedOutCount  Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template       MessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries     CampaignDelivery[]

  @@index([organizationId, eventId, createdAt])
}

model CampaignDelivery {
  id                String          @id @default(cuid())
  organizationId    String
  eventId           String
  campaignId        String
  personId          String?
  channel           DeliveryChannel
  recipient         String
  status            DeliveryStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime        @default(now())
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  person            Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([organizationId, eventId, createdAt])
}
