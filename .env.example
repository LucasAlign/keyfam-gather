DATABASE_URL="postgresql://gather:gather_dev@localhost:5432/gather?schema=public"

# Secret used to sign session cookies. Use at least 32 random characters.
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Canonical public origin used in invitation messages. Required when a real
# delivery provider is enabled in production (for example, https://gather.example.org).
APP_ORIGIN="http://localhost:3000"

# Seed account provisioned by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@gather.local"
SEED_ADMIN_NAME="Gather Admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ORGANIZATION_NAME="Key Families"

# Invitation delivery provider selection. Defaults to "log", which records a
# delivery attempt without calling any external email/SMS API. Set these once
# a real provider is wired in behind src/lib/delivery.
EMAIL_DELIVERY_PROVIDER="log"
SMS_DELIVERY_PROVIDER="log"
